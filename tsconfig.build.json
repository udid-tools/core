{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "examples", "docs"]
}

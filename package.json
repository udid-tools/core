{
  "name": "@udid-tools/core",
  "version": "0.1.0-beta.13",
  "description": "Framework-agnostic TypeScript SDK for Apple Profile Service profiles, CMS signing, verification, and device response parsing.",
  "keywords": [
    "apple",
    "cms",
    "configuration-profile",
    "device-enrollment",
    "ios",
    "mobileconfig",
    "pkcs7",
    "pkcs12",
    "profile-service",
    "typescript",
    "udid"
  ],
  "homepage": "https://udid-tools.github.io/core/",
  "bugs": {
    "url": "https://github.com/udid-tools/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udid-tools/core.git"
  },
  "author": {
    "name": "Alexander Tartmin",
    "url": "https://www.linkedin.com/in/alexandertartmin",
    "email": "hello@udid.tools"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.19.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run docs:sync && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --root docs",
    "docs:sync": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro sync --root docs",
    "docs:check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check --root docs",
    "docs:build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build --root docs",
    "docs:api": "typedoc",
    "docs:api:check": "npm run docs:api && git diff --exit-code -- docs/src/content/docs/reference/api",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run docs:api:check && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run docs:check && npm run docs:build && npm run pack:check"
  },
  "dependencies": {
    "asn1js": "4.0.0",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "pkijs": "4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/starlight": "0.42.7",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "astro": "7.4.2",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.3",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "markdown-it": "14.3.3",
    "postcss-nested@6.2.0": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
